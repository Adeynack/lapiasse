<%# locals: (current_user:) %>
<%= render "c/card", title: "Current User" do %>
  <p>
    Currently logged as
    <%= current_user.display_name %>
    (<%= mail_to current_user.email %>).
  </p>

  <div class="button-bar">
    <%= link_to "Foo", root_path(foo: 42, sapin: "malin"), class: "button-bar__item" %>
    <%= button_to "Log out",
      destroy_user_session_path,
      method: :delete,
      class: "button-bar__item"
    %>
    <%= button_to "Bar", root_path, params: {foo: 42, sapin: "malin"}, class: "button-bar__item" %>

    <%= link_button_to "Log out",
      destroy_user_session_path,
      class: "button-bar__item",
      data: {
        turbo_method: :delete,
      } %>
    <%= link_to "Foo", root_path(foo: 42, sapin: "malin"), class: "button-bar__item" %>
  </div>

  <button>Default</button>
<% end %>
