<%# locals: (current_user:) %>
<%= render "c/card", title: "Current User" do %>
  <p>
    Currently logged as
    <%= current_user.display_name %>
    (<%= mail_to current_user.email %>).
  </p>

  <%= toolbar do |t| %>
    <%= t.delete "Foo", root_path(foo: 42, sapin: "malin") %>
    <%= t.delete "FooB", root_path(foo: 42, sapin: "malin") %>
    <%= t.delete "Log out", destroy_user_session_path %>
    <%= t.delete "Bar", root_path(foo: 42, sapin: "malin") %>
    <%= t.delete "Log out", destroy_user_session_path %>
    <%= t.to "Foo", root_path(foo: 42, sapin: "malin") %>
  <% end %>

  <button>Default</button>
<% end %>
